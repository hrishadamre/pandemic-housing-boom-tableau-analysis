    <worksheet name='04 Market Resilience Quadrant (2)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f2933' fontname='Georgia' fontsize='13'>Big boomers were not the ones that held value</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1f5fa8' fontname='Trebuchet MS' fontsize='10'>● Resilient growth  </run>
            <run bold='true' fontcolor='#4f8fcb' fontname='Trebuchet MS' fontsize='10'>● Emerging momentum  </run>
            <run bold='true' fontcolor='#c8501b' fontname='Trebuchet MS' fontsize='10'>● Boom &amp; correction  </run>
            <run bold='true' fontcolor='#d9873f' fontname='Trebuchet MS' fontsize='10'>● Persistent lag</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='9' italic='true'>Dashed lines = median county: about +36% growth in the boom, about +10% since Jun 2022. Each dot is one county (3,004 with data).</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='housingvalues_county_time' name='federated.0duybsb164gni9137orwr1ndk0vf' />
          </datasources>
          <datasource-dependencies datasource='federated.0duybsb164gni9137orwr1ndk0vf'>
            <column caption='Jan 2020 Value' datatype='real' name='[Calculation_6313575929769998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [FIPS] :&#10;    MAX(&#10;        IF [year] = 2020&#10;        AND [month] = 1&#10;        THEN [allhomes_median_midtier]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Jun 2022 Value' datatype='real' name='[Calculation_6313575929909263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [FIPS] :&#10;    MAX(&#10;        IF [year] = 2022&#10;        AND [month] = 6&#10;        THEN [allhomes_median_midtier]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Pandemic Boom Growth' datatype='real' default-format='p0.0%' name='[Calculation_6313575930015760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6313575929909263] - [Calculation_6313575929769998])&#10;/&#10;[Calculation_6313575929769998]' />
