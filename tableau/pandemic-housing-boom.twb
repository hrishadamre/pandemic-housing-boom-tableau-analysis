            <column caption='Jan 2020 Value' datatype='real' name='[Calculation_6313575929769998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [FIPS] :&#10;    MAX(&#10;        IF [year] = 2020&#10;        AND [month] = 1&#10;        THEN [allhomes_median_midtier]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Jun 2022 Value' datatype='real' name='[Calculation_6313575929909263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [FIPS] :&#10;    MAX(&#10;        IF [year] = 2022&#10;        AND [month] = 6&#10;        THEN [allhomes_median_midtier]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Pandemic Boom Growth' datatype='real' default-format='p0.0%' name='[Calculation_6313575930015760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6313575929909263] - [Calculation_6313575929769998])&#10;/&#10;[Calculation_6313575929769998]' />
            </column>
            <column caption='Jun 2026 Value' datatype='real' name='[Calculation_6313575930187793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [FIPS] :&#10;    MAX(&#10;        IF [year] = 2026&#10;        AND [month] = 6&#10;        THEN [allhomes_median_midtier]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Post-2022 Growth' datatype='real' default-format='p0.0%' name='[Calculation_6313575930294290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6313575930187793] - [Calculation_6313575929909263])&#10;/&#10;[Calculation_6313575929909263]' />
            </column>
            <column caption='Market Segment' datatype='string' name='[Calculation_6313575932051475]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF ISNULL([Calculation_6313575930015760]) OR ISNULL([Calculation_6313575930294290]) THEN NULL&#10;ELSEIF [Calculation_6313575930015760] &gt;= { FIXED : MEDIAN([Calculation_6313575930015760]) }&#10;AND [Calculation_6313575930294290] &gt;= { FIXED : MEDIAN([Calculation_6313575930294290]) }&#10;THEN &quot;Resilient Growth&quot;&#10;&#10;ELSEIF [Calculation_6313575930015760] &gt;= { FIXED : MEDIAN([Calculation_6313575930015760]) }&#10;AND [Calculation_6313575930294290] &lt; { FIXED : MEDIAN([Calculation_6313575930294290]) }&#10;THEN &quot;Boom &amp; Correction&quot;&#10;&#10;ELSEIF [Calculation_6313575930015760] &lt; { FIXED : MEDIAN([Calculation_6313575930015760]) }&#10;AND [Calculation_6313575930294290] &gt;= { FIXED : MEDIAN([Calculation_6313575930294290]) }&#10;THEN &quot;Emerging Momentum&quot;&#10;&#10;ELSE &quot;Persistent Lag&quot;&#10;END' />
            </column>
            <column caption='% Lost Value' datatype='real' default-format='p0%' name='[Calculation_9120000000000007]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_6313575930294290] &lt; 0 THEN [FIPS] END)&#10;/ COUNTD(IF NOT ISNULL([Calculation_6313575930294290]) THEN [FIPS] END)' />
            </column>
            <column caption='Metro Highlight' datatype='string' name='[Calculation_9120000000000008]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [urban_rural_classification] = &quot;1LargeCentralMetro&quot; THEN &quot;Large central metro&quot; ELSE &quot;Other county types&quot; END' />
            </column>
            <column aggregation='Sum' caption='Counties' datatype='integer' name='[FIPS]' role='dimension' type='ordinal' />
            <column caption='Home value' datatype='real' name='[allhomes_median_midtier]' role='measure' type='quantitative' />
            <column caption='Month' datatype='integer' name='[month]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_9120000000000008]' derivation='None' name='[none:Calculation_9120000000000008:nk]' pivot='key' type='nominal' />
            <column-instance column='[urban_rural_classification]' derivation='None' name='[none:urban_rural_classification:nk]' pivot='key' type='nominal' />
            <column caption='Urban Rural Classification' datatype='string' name='[urban_rural_classification]' role='dimension' type='nominal'>
              <aliases>
