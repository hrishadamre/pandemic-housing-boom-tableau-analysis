    <worksheet name='09b State Payment-to-Income'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f2933' fontname='Georgia' fontsize='13'>Payment tops 30% of income in 16 states and DC</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='10'>Median county monthly payment as share of household income, Jun 2026 (states at 28% or more; HI = 4 counties; CT has no income data)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='housingvalues_county_time' name='federated.0duybsb164gni9137orwr1ndk0vf' />
          </datasources>
          <datasource-dependencies datasource='federated.0duybsb164gni9137orwr1ndk0vf'>
            <column caption='Monthly Mortgage Rate' datatype='real' name='[Calculation_6313575938756640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[us_frm_30yr] / 100 / 12' />
            </column>
            <column caption='Estimated Loan Amount' datatype='real' name='[Calculation_6313575938834465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[allhomes_median_midtier] * 0.80' />
            </column>
            <column caption='Monthly payment (P&amp;I)' datatype='real' name='[Calculation_6313575938920482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6313575938834465] *&#10;(&#10;    [Calculation_6313575938756640] *&#10;    (1 + [Calculation_6313575938756640]) ^ 360&#10;)&#10;/&#10;(&#10;    (1 + [Calculation_6313575938756640]) ^ 360 - 1&#10;)' />
            </column>
            <column caption='Payment-to-Income (Jun 2026)' datatype='real' default-format='p0%' name='[Calculation_9120000000000009]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [year] = 2026 AND [month] = 6 THEN [Calculation_6313575938920482] * 12 / [median_hh_income] END' />
            </column>
            <column caption='Over 30%' datatype='string' name='[Calculation_9120000000000010]' role='measure' type='nominal'>
