  <dashboards>
    <dashboard enable-sort-zone-taborder='true' name='DB1 - National Cycle'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f2933' fontname='Georgia' fontsize='20'>Nearly every county boomed; since 2022, 23% have lost value</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='11'>The pandemic boom lifted almost every county, but the 30-year rate shock split the aftermath.</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='1' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='2' param='vert' type-v2='layout-flow' w='98666' x='667' y='1000'>
            <zone h='7125' id='3' type-v2='title' w='98666' x='667' y='1000'>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='47500' id='4' name='01 Market Timeline' w='98666' x='667' y='8125'>
              <layout-cache minheight='307' type-h='scalable' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='37250' id='5' param='horz' type-v2='layout-flow' w='98666' x='667' y='55625'>
              <zone h='37250' id='6' name='02 County Growth Layers' w='83581' x='667' y='55625'>
                <layout-cache cell-count-w='17' minheight='225' non-cell-size-w='66' type-h='scalable' type-w='cell' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='37250' id='7' name='02 County Growth Layers' pane-specification-id='0' param='[federated.0duybsb164gni9137orwr1ndk0vf].[none:Calculation_9120000000000002:nk]' type-v2='color' w='15084' x='84248' y='55625'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='none' />
                  <format attr='border-width' value='0' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
            </zone>
            <zone h='6125' id='8' type-v2='text' w='98666' x='667' y='92875'>
              <formatted-text>
                <run bold='true' fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='9'>Why 2022 matters: </run>
                <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='9'>the Fed began raising rates on Mar 16, 2022 (federal funds rate 5.25–5.50% by Jul 2023). Owners with cheap older mortgages stopped selling; FHFA estimates this “lock-in” prevented about </run>
                <run bold='true' fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='9'>1.72 million home sales (2022 Q2–2024 Q2)</run>
                <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='9'>, which helped hold prices up.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='8' italic='true'>Sources: course housing dataset (county home values, 30-yr fixed rate); Federal Reserve; FHFA Working Paper 24-03.</run>
              </formatted-text>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{9DEA7F3E-8A29-4000-97CB-4B6C755A8934}' />
    </dashboard>
    <dashboard enable-sort-zone-taborder='true' name='DB2 - Market Divergence'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f2933' fontname='Georgia' fontsize='20'>Boom size didn’t predict the aftermath; place did</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='11'>Counties split into four paths by growth in the boom vs. since Jun 2022; big-city counties fared worst.</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' sizing-mode='fixed' />
      <datasources>
        <datasource name='Parameters' />
      </datasources>
      <datasource-dependencies datasource='Parameters'>
        <column caption='Show Segment' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Resilient Growth&quot;'>
          <calculation class='tableau' formula='&quot;Resilient Growth&quot;' />
          <members>
