  <worksheets>
    <worksheet name='01 Market Timeline'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f2933' fontname='Georgia' fontsize='13'>Home values kept rising even as mortgage rates jumped</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#44546a' fontname='Trebuchet MS' fontsize='10'>— Median county home value  </run>
            <run bold='true' fontcolor='#8c4a9e' fontname='Trebuchet MS' fontsize='10'>— 30-year mortgage rate</run>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='10'>   Jan 2000–Jun 2026</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='9' italic='true'>Fed began raising rates Mar 16, 2022 (5.25–5.50% by Jul 2023). Mortgage rate low 2.7% (Dec 2020), peak 7.6% (Oct 2023), now 6.5%. Source: Federal Reserve.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='housingvalues_county_time' name='federated.0duybsb164gni9137orwr1ndk0vf' />
          </datasources>
          <datasource-dependencies datasource='federated.0duybsb164gni9137orwr1ndk0vf'>
            <column caption='Date' datatype='date' name='[Calculation_6313575922466817]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE([year], [month], 1)' />
            </column>
            <column caption='Home value' datatype='real' name='[allhomes_median_midtier]' role='measure' type='quantitative' />
            <column-instance column='[us_frm_30yr]' derivation='Avg' name='[avg:us_frm_30yr:qk]' pivot='key' type='quantitative' />
            <column-instance column='[allhomes_median_midtier]' derivation='Median' name='[med:allhomes_median_midtier:qk]' pivot='key' type='quantitative' />
