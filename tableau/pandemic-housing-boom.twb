      </column>
      <column caption='Metro Highlight' datatype='string' name='[Calculation_9120000000000008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [urban_rural_classification] = &quot;1LargeCentralMetro&quot; THEN &quot;Large central metro&quot; ELSE &quot;Other county types&quot; END' />
      </column>
      <column caption='Payment-to-Income (Jun 2026)' datatype='real' default-format='p0%' name='[Calculation_9120000000000009]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [year] = 2026 AND [month] = 6 THEN [Calculation_6313575938920482] * 12 / [median_hh_income] END' />
      </column>
      <column caption='Over 30%' datatype='string' name='[Calculation_9120000000000010]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MEDIAN([Calculation_9120000000000009]) &gt; 0.30 THEN &quot;Over 30% of income&quot; ELSE &quot;30% or less&quot; END' />
      </column>
      <column caption='Rate Jan 2020' datatype='real' name='[Calculation_9120000000000011]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [year] = 2020 AND [month] = 1 THEN [Calculation_6313575938756640] END) }' />
      </column>
      <column caption='Rate Jun 2026' datatype='real' name='[Calculation_9120000000000012]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : MAX(IF [year] = 2026 AND [month] = 6 THEN [Calculation_6313575938756640] END) }' />
      </column>
      <column caption='P&amp;I Jan 2020' datatype='real' name='[Calculation_9120000000000013]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(IF [year] = 2020 AND [month] = 1 THEN [Calculation_6313575938920482] END)' />
      </column>
      <column caption='P&amp;I Jun 2026' datatype='real' name='[Calculation_9120000000000014]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(IF [year] = 2026 AND [month] = 6 THEN [Calculation_6313575938920482] END)' />
      </column>
      <column caption='P&amp;I 2026 prices at 2020 rate' datatype='real' name='[Calculation_9120000000000015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(IF [year] = 2026 AND [month] = 6 THEN [allhomes_median_midtier] * 0.80 * ([Calculation_9120000000000011] * (1 + [Calculation_9120000000000011]) ^ 360) / ((1 + [Calculation_9120000000000011]) ^ 360 - 1) END)' />
      </column>
      <column caption='P&amp;I 2020 prices at 2026 rate' datatype='real' name='[Calculation_9120000000000016]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MEDIAN(IF [year] = 2020 AND [month] = 1 THEN [allhomes_median_midtier] * 0.80 * ([Calculation_9120000000000012] * (1 + [Calculation_9120000000000012]) ^ 360) / ((1 + [Calculation_9120000000000012]) ^ 360 - 1) END)' />
      </column>
      <column caption='Payment Jan 2020 (fixed)' datatype='real' name='[Calculation_9120000000000017]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : [Calculation_9120000000000013] }' />
      </column>
      <column caption='Higher home prices (fixed)' datatype='real' name='[Calculation_9120000000000018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : (([Calculation_9120000000000015] - [Calculation_9120000000000013]) + ([Calculation_9120000000000014] - [Calculation_9120000000000016])) / 2 }' />
      </column>
      <column caption='Higher mortgage rates (fixed)' datatype='real' name='[Calculation_9120000000000019]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : (([Calculation_9120000000000014] - [Calculation_9120000000000015]) + ([Calculation_9120000000000016] - [Calculation_9120000000000013])) / 2 }' />
      </column>
      <column caption='Payment Component' datatype='string' name='[Calculation_9120000000000020]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [year] = 2020 AND [month] = 1 THEN &quot;Jan 2020 payment&quot;&#10;ELSEIF [year] = 2020 AND [month] = 2 THEN &quot;+ Higher home prices&quot;&#10;ELSEIF [year] = 2020 AND [month] = 3 THEN &quot;+ Higher mortgage rates&quot;&#10;END' />
        <aliases>
          <alias key='&quot;1 Jan 2020 payment&quot;' value='Jan 2020 payment' />
          <alias key='&quot;2 Higher home prices&quot;' value='+ Higher home prices' />
          <alias key='&quot;3 Higher mortgage rates&quot;' value='+ Higher mortgage rates' />
        </aliases>
      </column>
      <column caption='Monthly payment ($)' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Calculation_9120000000000021]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE ATTR([Calculation_9120000000000020])&#10;WHEN &quot;Jan 2020 payment&quot; THEN MAX([Calculation_9120000000000017])&#10;WHEN &quot;+ Higher home prices&quot; THEN MAX([Calculation_9120000000000018])&#10;WHEN &quot;+ Higher mortgage rates&quot; THEN MAX([Calculation_9120000000000019])&#10;END' />
