    <worksheet name='12 Estimated Monthly Financing Cost'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f2933' fontname='Georgia' fontsize='13'>The payment rose 106% while the home value rose 49%</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='10'>— Estimated monthly payment (P&amp;I)  </run>
            <run bold='true' fontcolor='#44546a' fontname='Trebuchet MS' fontsize='10'>— Median county home value</run>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='10'>   20% down, 30-year fixed</run>
          </formatted-text>
        </title>
        <caption>
          <formatted-text>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='9' italic='true'>Context: payment rose 106% ($582 → $1,197) while home values rose 49%; the gap is the mortgage-rate increase.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='housingvalues_county_time' name='federated.0duybsb164gni9137orwr1ndk0vf' />
          </datasources>
          <datasource-dependencies datasource='federated.0duybsb164gni9137orwr1ndk0vf'>
            <column caption='Date' datatype='date' name='[Calculation_6313575922466817]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE([year], [month], 1)' />
            </column>
            <column caption='Monthly Mortgage Rate' datatype='real' name='[Calculation_6313575938756640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[us_frm_30yr] / 100 / 12' />
            </column>
            <column caption='Estimated Loan Amount' datatype='real' name='[Calculation_6313575938834465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[allhomes_median_midtier] * 0.80' />
            </column>
            <column caption='Monthly payment (P&amp;I)' datatype='real' name='[Calculation_6313575938920482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6313575938834465] *&#10;(&#10;    [Calculation_6313575938756640] *&#10;    (1 + [Calculation_6313575938756640]) ^ 360&#10;)&#10;/&#10;(&#10;    (1 + [Calculation_6313575938756640]) ^ 360 - 1&#10;)' />
            </column>
            <column caption='Home value' datatype='real' name='[allhomes_median_midtier]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_6313575938920482]' derivation='Median' name='[med:Calculation_6313575938920482:qk]' pivot='key' type='quantitative' />
            <column-instance column='[allhomes_median_midtier]' derivation='Median' name='[med:allhomes_median_midtier:qk]' pivot='key' type='quantitative' />
            <column caption='Month' datatype='integer' name='[month]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_6313575922466817]' derivation='Month-Trunc' name='[tmn:Calculation_6313575922466817:qk]' pivot='key' type='quantitative' />
