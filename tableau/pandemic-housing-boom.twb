    <worksheet name='02 County Growth Layers'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f2933' fontname='Georgia' fontsize='13'>After mid-2022, the whole county distribution shifted left</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='10'>Boom (Jan 2020–Jun 2022): median county +36%, 99% gained.  Since (Jun 2022–Jun 2026): median +10%, 678 counties (23%) lost value.</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='9'>Number of counties in each 10-point growth band</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='housingvalues_county_time' name='federated.0duybsb164gni9137orwr1ndk0vf' />
          </datasources>
          <datasource-dependencies datasource='federated.0duybsb164gni9137orwr1ndk0vf'>
            <column caption='Jan 2020 Value' datatype='real' name='[Calculation_6313575929769998]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [FIPS] :&#10;    MAX(&#10;        IF [year] = 2020&#10;        AND [month] = 1&#10;        THEN [allhomes_median_midtier]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Jun 2022 Value' datatype='real' name='[Calculation_6313575929909263]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [FIPS] :&#10;    MAX(&#10;        IF [year] = 2022&#10;        AND [month] = 6&#10;        THEN [allhomes_median_midtier]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Pandemic Boom Growth' datatype='real' default-format='p0.0%' name='[Calculation_6313575930015760]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6313575929909263] - [Calculation_6313575929769998])&#10;/&#10;[Calculation_6313575929769998]' />
            </column>
            <column caption='Jun 2026 Value' datatype='real' name='[Calculation_6313575930187793]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [FIPS] :&#10;    MAX(&#10;        IF [year] = 2026&#10;        AND [month] = 6&#10;        THEN [allhomes_median_midtier]&#10;        END&#10;    )&#10;}' />
            </column>
            <column caption='Post-2022 Growth' datatype='real' default-format='p0.0%' name='[Calculation_6313575930294290]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_6313575930187793] - [Calculation_6313575929909263])&#10;/&#10;[Calculation_6313575929909263]' />
            </column>
            <column caption='Layer Growth' datatype='real' name='[Calculation_9120000000000001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [year] = 2022 AND [month] = 6 THEN [Calculation_6313575930015760]&#10;ELSEIF [year] = 2026 AND [month] = 6 THEN [Calculation_6313575930294290]&#10;END' />
            </column>
            <column caption='Layer' datatype='string' name='[Calculation_9120000000000002]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [year] = 2022 AND [month] = 6 THEN &quot;Boom: Jan 2020–Jun 2022&quot;&#10;ELSEIF [year] = 2026 AND [month] = 6 THEN &quot;Since: Jun 2022–Jun 2026&quot;&#10;END' />
            </column>
            <column aggregation='Sum' caption='Counties' datatype='integer' name='[FIPS]' role='dimension' type='ordinal' />
            <column aggregation='None' caption='Home-value growth over the period' datatype='integer' default-format='p0%' name='[Layer Growth (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='-2' formula='[Calculation_9120000000000001]' peg='0' size='0.1' />
            </column>
            <column caption='Home value' datatype='real' name='[allhomes_median_midtier]' role='measure' type='quantitative' />
            <column-instance column='[FIPS]' derivation='CountD' name='[ctd:FIPS:qk]' pivot='key' type='quantitative' />
            <column caption='Month' datatype='integer' name='[month]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_9120000000000001]' derivation='None' name='[none:Calculation_9120000000000001:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_9120000000000002]' derivation='None' name='[none:Calculation_9120000000000002:nk]' pivot='key' type='nominal' />
            <column-instance column='[Layer Growth (bin)]' derivation='None' name='[none:Layer Growth (bin):ok]' pivot='key' type='ordinal' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
