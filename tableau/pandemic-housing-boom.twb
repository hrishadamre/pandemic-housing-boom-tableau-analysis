    <worksheet name='12b Payment Split'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#1f2933' fontname='Georgia' fontsize='13'>Prices and rates each added hundreds of dollars a month</run>
            <run>Æ&#10;</run>
            <run fontcolor='#1f2933' fontname='Trebuchet MS' fontsize='10'>Extra $615/month: home prices ≈ 55%, mortgage rates ≈ 45%</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='housingvalues_county_time' name='federated.0duybsb164gni9137orwr1ndk0vf' />
          </datasources>
          <datasource-dependencies datasource='federated.0duybsb164gni9137orwr1ndk0vf'>
            <column caption='Monthly Mortgage Rate' datatype='real' name='[Calculation_6313575938756640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[us_frm_30yr] / 100 / 12' />
            </column>
            <column caption='Estimated Loan Amount' datatype='real' name='[Calculation_6313575938834465]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[allhomes_median_midtier] * 0.80' />
            </column>
            <column caption='Monthly payment (P&amp;I)' datatype='real' name='[Calculation_6313575938920482]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_6313575938834465] *&#10;(&#10;    [Calculation_6313575938756640] *&#10;    (1 + [Calculation_6313575938756640]) ^ 360&#10;)&#10;/&#10;(&#10;    (1 + [Calculation_6313575938756640]) ^ 360 - 1&#10;)' />
            </column>
            <column caption='Rate Jan 2020' datatype='real' name='[Calculation_9120000000000011]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MAX(IF [year] = 2020 AND [month] = 1 THEN [Calculation_6313575938756640] END) }' />
            </column>
            <column caption='Rate Jun 2026' datatype='real' name='[Calculation_9120000000000012]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : MAX(IF [year] = 2026 AND [month] = 6 THEN [Calculation_6313575938756640] END) }' />
            </column>
            <column caption='P&amp;I Jan 2020' datatype='real' name='[Calculation_9120000000000013]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(IF [year] = 2020 AND [month] = 1 THEN [Calculation_6313575938920482] END)' />
            </column>
            <column caption='P&amp;I Jun 2026' datatype='real' name='[Calculation_9120000000000014]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(IF [year] = 2026 AND [month] = 6 THEN [Calculation_6313575938920482] END)' />
            </column>
            <column caption='P&amp;I 2026 prices at 2020 rate' datatype='real' name='[Calculation_9120000000000015]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(IF [year] = 2026 AND [month] = 6 THEN [allhomes_median_midtier] * 0.80 * ([Calculation_9120000000000011] * (1 + [Calculation_9120000000000011]) ^ 360) / ((1 + [Calculation_9120000000000011]) ^ 360 - 1) END)' />
            </column>
            <column caption='P&amp;I 2020 prices at 2026 rate' datatype='real' name='[Calculation_9120000000000016]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MEDIAN(IF [year] = 2020 AND [month] = 1 THEN [allhomes_median_midtier] * 0.80 * ([Calculation_9120000000000012] * (1 + [Calculation_9120000000000012]) ^ 360) / ((1 + [Calculation_9120000000000012]) ^ 360 - 1) END)' />
            </column>
            <column caption='Payment Jan 2020 (fixed)' datatype='real' name='[Calculation_9120000000000017]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : [Calculation_9120000000000013] }' />
            </column>
            <column caption='Higher home prices (fixed)' datatype='real' name='[Calculation_9120000000000018]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : (([Calculation_9120000000000015] - [Calculation_9120000000000013]) + ([Calculation_9120000000000014] - [Calculation_9120000000000016])) / 2 }' />
            </column>
            <column caption='Higher mortgage rates (fixed)' datatype='real' name='[Calculation_9120000000000019]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED : (([Calculation_9120000000000014] - [Calculation_9120000000000015]) + ([Calculation_9120000000000016] - [Calculation_9120000000000013])) / 2 }' />
            </column>
            <column caption='Payment Component' datatype='string' name='[Calculation_9120000000000020]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [year] = 2020 AND [month] = 1 THEN &quot;Jan 2020 payment&quot;&#10;ELSEIF [year] = 2020 AND [month] = 2 THEN &quot;+ Higher home prices&quot;&#10;ELSEIF [year] = 2020 AND [month] = 3 THEN &quot;+ Higher mortgage rates&quot;&#10;END' />
              <aliases>
                <alias key='&quot;1 Jan 2020 payment&quot;' value='Jan 2020 payment' />
                <alias key='&quot;2 Higher home prices&quot;' value='+ Higher home prices' />
                <alias key='&quot;3 Higher mortgage rates&quot;' value='+ Higher mortgage rates' />
              </aliases>
            </column>
            <column caption='Monthly payment ($)' datatype='real' default-format='c&quot;$&quot;#,##0' name='[Calculation_9120000000000021]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE ATTR([Calculation_9120000000000020])&#10;WHEN &quot;Jan 2020 payment&quot; THEN MAX([Calculation_9120000000000017])&#10;WHEN &quot;+ Higher home prices&quot; THEN MAX([Calculation_9120000000000018])&#10;WHEN &quot;+ Higher mortgage rates&quot; THEN MAX([Calculation_9120000000000019])&#10;END' />
            </column>
            <column caption='Home value' datatype='real' name='[allhomes_median_midtier]' role='measure' type='quantitative' />
            <column caption='Month' datatype='integer' name='[month]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_9120000000000020]' derivation='None' name='[none:Calculation_9120000000000020:nk]' pivot='key' type='nominal' />
            <column caption='30-yr mortgage rate' datatype='real' default-format='n0.0&quot;%&quot;' name='[us_frm_30yr]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_9120000000000021]' derivation='User' name='[usr:Calculation_9120000000000021:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0duybsb164gni9137orwr1ndk0vf].[usr:Calculation_9120000000000021:qk]' included-values='non-null' />
          <slices>
            <column>[federated.0duybsb164gni9137orwr1ndk0vf].[usr:Calculation_9120000000000021:qk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='label'>
            <format attr='text-format' field='[federated.0duybsb164gni9137orwr1ndk0vf].[usr:Calculation_9120000000000021:qk]' value='c&quot;$&quot;#,##0' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='on' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.0duybsb164gni9137orwr1ndk0vf].[none:Calculation_9120000000000020:nk]' />
              <text column='[federated.0duybsb164gni9137orwr1ndk0vf].[none:Calculation_9120000000000020:nk]' />
              <text column='[federated.0duybsb164gni9137orwr1ndk0vf].[usr:Calculation_9120000000000021:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols>[federated.0duybsb164gni9137orwr1ndk0vf].[usr:Calculation_9120000000000021:qk]</cols>
      </table>
      <simple-id uuid='{6C033A3B-6F50-4764-9F80-1A9F0CC7D6E1}' />
    </worksheet>
    <worksheet name='13 Economic Context'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Benton Sans Book'>How Did Housing Values Move as Interest Rates Rose?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='12' italic='true'>Federal funds rate and median county home value, 2000–2026</run>
            <run>Æ&#10;&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='housingvalues_county_time' name='federated.0duybsb164gni9137orwr1ndk0vf' />
          </datasources>
          <datasource-dependencies datasource='federated.0duybsb164gni9137orwr1ndk0vf'>
            <column caption='Date' datatype='date' name='[Calculation_6313575922466817]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE([year], [month], 1)' />
            </column>
            <column caption='Home value' datatype='real' name='[allhomes_median_midtier]' role='measure' type='quantitative' />
            <column-instance column='[federal_funds_rate]' derivation='Avg' name='[avg:federal_funds_rate:qk]' pivot='key' type='quantitative' />
            <column caption='Federal Funds Rate' datatype='real' name='[federal_funds_rate]' role='measure' type='quantitative' />
            <column-instance column='[allhomes_median_midtier]' derivation='Median' name='[med:allhomes_median_midtier:qk]' pivot='key' type='quantitative' />
            <column caption='Month' datatype='integer' name='[month]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_6313575922466817]' derivation='Month-Trunc' name='[tmn:Calculation_6313575922466817:qk]' pivot='key' type='quantitative' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='quantitative' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0duybsb164gni9137orwr1ndk0vf].[tmn:Calculation_6313575922466817:qk]' included-values='non-null' />
