      </column>
      <column caption='Monthly payment (P&amp;I)' datatype='real' name='[Calculation_6313575938920482]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_6313575938834465] *&#10;(&#10;    [Calculation_6313575938756640] *&#10;    (1 + [Calculation_6313575938756640]) ^ 360&#10;)&#10;/&#10;(&#10;    (1 + [Calculation_6313575938756640]) ^ 360 - 1&#10;)' />
      </column>
      <column caption='Layer Growth' datatype='real' name='[Calculation_9120000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [year] = 2022 AND [month] = 6 THEN [Calculation_6313575930015760]&#10;ELSEIF [year] = 2026 AND [month] = 6 THEN [Calculation_6313575930294290]&#10;END' />
      </column>
      <column caption='Layer' datatype='string' name='[Calculation_9120000000000002]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [year] = 2022 AND [month] = 6 THEN &quot;Boom: Jan 2020–Jun 2022&quot;&#10;ELSEIF [year] = 2026 AND [month] = 6 THEN &quot;Since: Jun 2022–Jun 2026&quot;&#10;END' />
      </column>
      <column caption='Tile X' datatype='integer' name='[Calculation_9120000000000003]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [state]&#10;WHEN &quot;AK&quot; THEN 0 WHEN &quot;AL&quot; THEN 6 WHEN &quot;AR&quot; THEN 4 WHEN &quot;AZ&quot; THEN 1 WHEN &quot;CA&quot; THEN 0 WHEN &quot;CO&quot; THEN 2&#10;WHEN &quot;CT&quot; THEN 9 WHEN &quot;DC&quot; THEN 8 WHEN &quot;DE&quot; THEN 9 WHEN &quot;FL&quot; THEN 8 WHEN &quot;GA&quot; THEN 7 WHEN &quot;HI&quot; THEN 0&#10;WHEN &quot;IA&quot; THEN 4 WHEN &quot;ID&quot; THEN 1 WHEN &quot;IL&quot; THEN 5 WHEN &quot;IN&quot; THEN 5 WHEN &quot;KS&quot; THEN 3 WHEN &quot;KY&quot; THEN 5&#10;WHEN &quot;LA&quot; THEN 4 WHEN &quot;MA&quot; THEN 10 WHEN &quot;MD&quot; THEN 8 WHEN &quot;ME&quot; THEN 10 WHEN &quot;MI&quot; THEN 7 WHEN &quot;MN&quot; THEN 4&#10;WHEN &quot;MO&quot; THEN 4 WHEN &quot;MS&quot; THEN 5 WHEN &quot;MT&quot; THEN 2 WHEN &quot;NC&quot; THEN 6 WHEN &quot;ND&quot; THEN 3 WHEN &quot;NE&quot; THEN 3&#10;WHEN &quot;NH&quot; THEN 10 WHEN &quot;NJ&quot; THEN 8 WHEN &quot;NM&quot; THEN 2 WHEN &quot;NV&quot; THEN 1 WHEN &quot;NY&quot; THEN 8 WHEN &quot;OH&quot; THEN 6&#10;WHEN &quot;OK&quot; THEN 3 WHEN &quot;OR&quot; THEN 0 WHEN &quot;PA&quot; THEN 7 WHEN &quot;RI&quot; THEN 9 WHEN &quot;SC&quot; THEN 7 WHEN &quot;SD&quot; THEN 3&#10;WHEN &quot;TN&quot; THEN 5 WHEN &quot;TX&quot; THEN 3 WHEN &quot;UT&quot; THEN 1 WHEN &quot;VA&quot; THEN 7 WHEN &quot;VT&quot; THEN 9 WHEN &quot;WA&quot; THEN 0&#10;WHEN &quot;WI&quot; THEN 6 WHEN &quot;WV&quot; THEN 6 WHEN &quot;WY&quot; THEN 2&#10;END' />
      </column>
      <column caption='Tile Y' datatype='integer' name='[Calculation_9120000000000004]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='CASE [state]&#10;WHEN &quot;AK&quot; THEN 0 WHEN &quot;AL&quot; THEN 6 WHEN &quot;AR&quot; THEN 5 WHEN &quot;AZ&quot; THEN 5 WHEN &quot;CA&quot; THEN 4 WHEN &quot;CO&quot; THEN 4&#10;WHEN &quot;CT&quot; THEN 3 WHEN &quot;DC&quot; THEN 5 WHEN &quot;DE&quot; THEN 4 WHEN &quot;FL&quot; THEN 7 WHEN &quot;GA&quot; THEN 6 WHEN &quot;HI&quot; THEN 7&#10;WHEN &quot;IA&quot; THEN 3 WHEN &quot;ID&quot; THEN 2 WHEN &quot;IL&quot; THEN 2 WHEN &quot;IN&quot; THEN 3 WHEN &quot;KS&quot; THEN 5 WHEN &quot;KY&quot; THEN 4&#10;WHEN &quot;LA&quot; THEN 6 WHEN &quot;MA&quot; THEN 2 WHEN &quot;MD&quot; THEN 4 WHEN &quot;ME&quot; THEN 0 WHEN &quot;MI&quot; THEN 2 WHEN &quot;MN&quot; THEN 2&#10;WHEN &quot;MO&quot; THEN 4 WHEN &quot;MS&quot; THEN 6 WHEN &quot;MT&quot; THEN 2 WHEN &quot;NC&quot; THEN 5 WHEN &quot;ND&quot; THEN 2 WHEN &quot;NE&quot; THEN 4&#10;WHEN &quot;NH&quot; THEN 1 WHEN &quot;NJ&quot; THEN 3 WHEN &quot;NM&quot; THEN 5 WHEN &quot;NV&quot; THEN 3 WHEN &quot;NY&quot; THEN 2 WHEN &quot;OH&quot; THEN 3&#10;WHEN &quot;OK&quot; THEN 6 WHEN &quot;OR&quot; THEN 3 WHEN &quot;PA&quot; THEN 3 WHEN &quot;RI&quot; THEN 2 WHEN &quot;SC&quot; THEN 5 WHEN &quot;SD&quot; THEN 3&#10;WHEN &quot;TN&quot; THEN 5 WHEN &quot;TX&quot; THEN 7 WHEN &quot;UT&quot; THEN 4 WHEN &quot;VA&quot; THEN 4 WHEN &quot;VT&quot; THEN 1 WHEN &quot;WA&quot; THEN 2&#10;WHEN &quot;WI&quot; THEN 2 WHEN &quot;WV&quot; THEN 4 WHEN &quot;WY&quot; THEN 3&#10;END' />
      </column>
      <column caption='Share of counties in segment' datatype='real' default-format='p0%' name='[Calculation_9120000000000005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_6313575932051475] = [Parameters].[Parameter 1] THEN [FIPS] END)&#10;/ COUNTD(IF NOT ISNULL([Calculation_6313575932051475]) THEN [FIPS] END)' />
      </column>
      <column caption='Tile Label' datatype='string' name='[Calculation_9120000000000006]' role='measure' type='nominal'>
        <calculation class='tableau' formula='ATTR([state]) + IF COUNTD([FIPS]) &lt; 10 THEN &quot;*&quot; ELSE &quot;&quot; END + CHAR(10) + IF ISNULL([Calculation_9120000000000005]) THEN &quot;–&quot; ELSE STR(ROUND([Calculation_9120000000000005] * 100, 0)) + &quot;%&quot; END' />
